# FindOPENPSF
include(FindPackageHandleStandardArgs)

if(NOT OPENPSF_FOUND)
    get_filename_component(SEARCH_PATH "${CMAKE_CURRENT_LIST_FILE}" PATH)
    get_filename_component(SEARCH_PATH "${SEARCH_PATH}" PATH)
    get_filename_component(SEARCH_PATH "${SEARCH_PATH}" PATH)

    find_path(OPENPSF_INCLUDE_DIRS NAMES openpsf/openpsf.h PATHS ${SEARCH_PATH}/include NO_DEFAULT_PATH)
    find_library(OPENPSF_LIBRARY NAMES openpsf PATHS ${SEARCH_PATH}/lib NO_DEFAULT_PATH)
    find_library(PSFLIB_LIBRARY NAMES psflib PATHS ${SEARCH_PATH}/lib NO_DEFAULT_PATH)
    find_library(PSXCORE_LIBRARY NAMES PSXCore PATHS ${SEARCH_PATH}/lib NO_DEFAULT_PATH)

    if(OPENPSF_INCLUDE_DIRS AND OPENPSF_LIBRARY)
        set(OPENPSF_FOUND TRUE)
        set(OPENPSF_LIBRARIES ${OPENPSF_LIBRARY} ${PSFLIB_LIBRARY} ${PSXCORE_LIBRARY})
        set(OPENPSF_LIBRARY_DIRS ${SEARCH_PATH}/lib)
    endif()

    find_package_handle_standard_args(OPENPSF REQUIRED_VARS OPENPSF_INCLUDE_DIRS OPENPSF_LIBRARY)
endif()
